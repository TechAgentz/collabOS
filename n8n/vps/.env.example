# CollabOS n8n — VPS production environment.
#
#   cp .env.example .env && chmod 600 .env
#
# Then fill in every value below. `docker compose up` refuses to start while a
# mandatory one is missing. This file is committed; .env is NOT (see .gitignore).

# ─── Public address ──────────────────────────────────────────────────────────
# The subdomain whose A record points at this VPS's IPv4 address.
# Must resolve BEFORE the first `docker compose up`, or Let's Encrypt fails.
N8N_DOMAIN=n8n.yourdomain.com

# Where Let's Encrypt sends expiry warnings. A real inbox you read.
ACME_EMAIL=you@yourdomain.com

# ─── Secrets ─────────────────────────────────────────────────────────────────
# Generate both with:  openssl rand -hex 32
POSTGRES_PASSWORD=

# NEVER change this after the first boot, and keep an offline copy. n8n encrypts
# every stored credential (Gmail OAuth token, Meta app secret, the CollabOS
# header-auth secret) with it. Restoring a database dump without this exact key
# gives you back your workflows with every credential permanently unreadable.
N8N_ENCRYPTION_KEY=

# ─── Version pinning ─────────────────────────────────────────────────────────
# Leave as `latest` for the first boot. Then run
#   docker compose exec n8n n8n --version
# and paste that number here so updates are deliberate, not accidental.
N8N_IMAGE_TAG=latest

# ─── Behaviour ───────────────────────────────────────────────────────────────
# Drives Schedule/Cron trigger times and timestamps in the UI.
# e.g. Asia/Kolkata, Europe/London, America/New_York
GENERIC_TIMEZONE=UTC

# How long finished executions are kept. Hours. 336 = 14 days.
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000

# ─── CollabOS wiring (reference only — not read by docker compose) ───────────
# Env access inside workflows is deliberately blocked (see docker-compose.yml),
# so these are NOT injected into n8n. They are written here so the values live
# next to the deployment that uses them.
#
# The URL each workflow's final HTTP Request node POSTs to. Whatever host runs
# the Next.js app. CollabOS is on Vercel (verified 2026-09-05); the same-VPS
# alternative is described in README.md §7.
#   COLLABOS_INGEST_URL=https://collab-os-geoy.vercel.app/api/ingest
#
# Must equal N8N_WEBHOOK_SECRET in the app's environment. In n8n this becomes a
# "Header Auth" credential (name: x-webhook-secret), never a plain node field.
#   COLLABOS_WEBHOOK_SECRET=<same value the app has>
