# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never exposed to the client

# LLM — Groq, serving open-weight models (free tier) — https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Optional overrides:
# AI_MODEL=openai/gpt-oss-120b                # default (llama-3.3-70b was shut down by Groq 2026-08-16)
# AI_BASE_URL=http://localhost:11434/v1       # run fully local on Ollama instead

# Shared secret n8n must send as the `x-webhook-secret` header on /api/ingest
N8N_WEBHOOK_SECRET=generate-a-long-random-string

# n8n webhook the app POSTs to when you reply to a brand from a deal
N8N_OUTBOUND_WEBHOOK_URL=https://your-n8n-host/webhook/collabos-reply
